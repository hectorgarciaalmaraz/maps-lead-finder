# ============================================================
# MAPS LEAD FINDER
# Plantilla de variables de entorno
# Copia este archivo como .env en la raíz del proyecto
# y rellena con tus credenciales reales.
# ¡NUNCA subas .env a git!
# ============================================================

# ── Google Maps ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=TU_CLAVE_GOOGLE_MAPS_AQUI

# ── Anthropic Claude ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-TU_CLAVE_ANTHROPIC_AQUI

# ── Identidad de tu agencia (aparece en propuestas y remitente) ──
# Si dejas un valor vacío, las propuestas muestran el placeholder [NOMBRE_AGENCIA], [TELEFONO_AGENCIA], etc.
AGENCY_NAME=Tu Agencia
AGENCY_PHONE=+52 55 0000 0000
AGENCY_EMAIL=contacto@tu-agencia.com
AGENCY_WEBSITE=https://tu-agencia.com
AGENCY_FACEBOOK=https://facebook.com/tu-agencia
AGENCY_INSTAGRAM=https://instagram.com/tu-agencia
AGENCY_LINKEDIN=https://linkedin.com/company/tu-agencia

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@example.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ── SendGrid (alternativa a SMTP) ────────────────────────────
SENDGRID_API_KEY=

# ── Twilio (SMS y WhatsApp) ───────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# El mismo número se usa para SMS y para WhatsApp (prefijo whatsapp: lo agrega el código)
TWILIO_PHONE_NUMBER=+15551234567

# ── Notificaciones al creador ─────────────────────────────────
CREATOR_NAME=Tu Nombre
CREATOR_EMAIL=tu_email@example.com
CREATOR_PHONE=+52 55 0000 0000
# Canal preferido para avisos al creador: email o sms
CREATOR_PREFERRED_CONTACT=email

# ── Google Sheets (para exportar prospectos) ──────────────────
# 1. En Google Cloud Console, activa "Google Sheets API" y "Google Drive API"
# 2. Crea una Cuenta de Servicio → descarga el JSON de credenciales
# 3. Pon la ruta al JSON aquí (puede ser relativa a la raíz del proyecto)
# 4. Comparte el Sheet con el client_email de la cuenta de servicio (permiso de editor)
GOOGLE_SHEETS_CREDENTIALS_FILE=config/google_credentials.json
# (Opcional) ID de un Sheet existente para reusar en lugar de crear uno nuevo
# Se encuentra en la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Flask ─────────────────────────────────────────────────────
# Si se deja vacío se genera una clave aleatoria en cada arranque (las sesiones no sobreviven reinicios)
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# ── Centro geográfico por defecto para búsquedas (CDMX) ──────────
DEFAULT_CENTER_LAT=19.4326
DEFAULT_CENTER_LNG=-99.1332
